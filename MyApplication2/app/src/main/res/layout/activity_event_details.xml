<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Шапка с изображением -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="370dp">

            <ImageView
                android:id="@+id/eventImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay_premium" />

            <!-- Кнопка избранного -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_margin="20dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_white_elevation"
                    android:elevation="8dp"
                    android:padding="12dp"
                    android:src="@android:drawable/btn_star_big_off" />
            </LinearLayout>
        </FrameLayout>

        <!-- Основной контент -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F6FAFD"
            android:elevation="8dp"
            android:padding="32dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="29sp"
                android:textStyle="bold"
                android:lineSpacingExtra="8dp"
                android:textColor="#0A1931" />

            <TextView
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="19.5sp"
                android:textStyle="bold"
                android:textColor="#1A3D63" />

            <TextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:textSize="16.8sp"
                android:textColor="#4A7FA7"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/organizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16.2sp"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16.5sp"
                android:lineSpacingExtra="10dp"
                android:textColor="#334155" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="#B3CFE5" />

            <!-- Билеты и статус -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ticketsLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="17.5sp"
                    android:textColor="#1A3D63" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textStyle="bold"
                    android:textSize="17.5sp"
                    android:textColor="#4A7FA7" />
            </LinearLayout>

            <!-- Кнопка Купить -->
            <Button
                android:id="@+id/buyTicket"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="48dp"
                android:text="Купить билет"
                android:textSize="18.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_buy_premium_new"
                android:elevation="12dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>