@model List<EventPlatform.Models.Ticket>
@{
    Layout = "_OrganizerLayout";
}

<style>
.table-responsive {
    overflow: visible;
}
</style>

<div class="container-fluid px-4">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="mb-3">🎟 Билеты</h2>
    </div>

    <!-- TABLE CARD -->
    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Покупатель</th>

                        <th>Email</th>

                        <th>Дата покупки</th>

                        <th>Статус билета</th>

                        <th>QR-код</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var t in Model)
                    {
                        <tr>

                            <td>
                                @t.User.FullName
                            </td>

                            <td>
                                @t.User.Email
                            </td>

                            <td>
                                @t.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>

                                @if (t.Status == TicketStatus.Active)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (t.Status == TicketStatus.Used)
                                {
                                    <span class="badge bg-secondary">
                                        Used
                                    </span>
                                }
                                else if (t.Status == TicketStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }

                            </td>

                            <td>

                                <span class="text-muted small">
                                    @t.QrCode
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>