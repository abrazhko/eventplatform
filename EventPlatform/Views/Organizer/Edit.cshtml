@model EventPlatform.Models.Event

@{
    ViewData["Title"] = "Редактирование мероприятия";
    var categories = ViewBag.Categories as List<EventPlatform.Models.Category>;
    Layout = "_OrganizerLayout";
}
@{
    var error = TempData["Error"] as string;
    var success = TempData["Success"] as string;
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2>Редактирование мероприятия</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label>Текущее изображение</label><br/>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 width="120"
                 style="border-radius:8px"/>
        }

    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file"
               name="image"
               class="form-control"/>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Title">Название</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description">Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="StartDate">Дата начала</label>
        <input asp-for="StartDate" type="datetime-local" class="form-control" 
               value="@Model.StartDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="EndDate">Дата окончания</label>
        <input asp-for="EndDate" type="datetime-local" class="form-control" 
               value="@Model.EndDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Location">Место</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CategoryId">Категория</label>
        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(categories, "Id", "Name", Model.CategoryId))">
            <option value="">Выберите категорию</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">Цена</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Capacity">Лимит билетов</label>
        <input asp-for="Capacity" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Status">Статус</label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<EventPlatform.Models.EventStatus>()">
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Dashboard" class="btn btn-secondary">Назад</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
