@model List<EventPlatform.Models.Category>

@{
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">

    <!-- PAGE HEADER -->
    <div class="mb-4">
        <h2 class="mb-3">🏷 Управление категориями</h2>
        <a class="btn btn-primary" href="/Admin/AddCategory">
             Создать категорию
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">
            @TempData["Success"]
        </div>
    }

    <!-- TABLE CARD -->
    <div class="card shadow-sm">
        <div class="table-responsive p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td class="text-end">
                                <a class="btn btn-warning btn-sm" href="/Admin/EditCategory/@c.Id">Редактировать</a>

                                <form method="post" action="/Admin/DeleteCategory/@c.Id" class="d-inline">
                                    <button class="btn btn-danger btn-sm" onclick="return confirm('Удалить категорию?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>