@model AdminDashboardViewModel

@{
Layout = "_AdminLayout";
}

<div class="container-fluid px-4">

<div class="d-flex justify-content-between align-items-center mb-4">
<h2 class="mb-0">📊 Панель администратора</h2>
</div>


<!--KPI-->

<div class="row g-3 mb-4">

<div class="col-lg-3 col-md-6">
<div class="card shadow-sm h-100 text-center p-3">
<h6 class="text-muted">Пользователи</h6>
<h3>@Model.TotalUsers</h3>
</div>
</div>

<div class="col-lg-3 col-md-6">
<div class="card shadow-sm h-100 text-center p-3">
<h6 class="text-muted">Активные организаторы</h6>
<h3>@Model.ActiveOrganizers</h3>
</div>
</div>

<div class="col-lg-3 col-md-6">
<div class="card shadow-sm h-100 text-center p-3">
<h6 class="text-muted">Опубликованные мероприятия</h6>
<h3>@Model.PublishedEvents</h3>
</div>
</div>

<div class="col-lg-3 col-md-6">
<div class="card shadow-sm h-100 text-center p-3">
<h6 class="text-muted">Доход за месяц</h6>
<h3>@Model.MonthlyRevenue.ToString("N0") ₽</h3>
</div>
</div>

</div>


<!--GRAPH + EVENTS-->

<div class="row g-3 mb-4">

<div class="col-lg-8">

<div class="card shadow-sm p-3">

<div class="d-flex justify-content-between align-items-center mb-2">

<h5 class="mb-0">Продажи билетов</h5>

<span class="text-muted small">
последние 7 дней
</span>

</div>

<div style="height:320px">
<canvas id="salesChart"></canvas>
</div>

</div>

</div>


<div class="col-lg-4">

<div class="card shadow-sm">

<div class="card-header">
<h5 class="mb-0">Ближайшие мероприятия</h5>
</div>

<div class="card-body p-0">

<ul class="list-group list-group-flush">

@foreach (var ev in Model.UpcomingEvents.Take(5))
{
<li class="list-group-item py-3">

<div class="fw-bold">
@ev.Title
</div>

<div class="text-muted small">
@ev.StartDate.ToString("dd.MM.yyyy")
</div>

<div class="small">
Организатор: @ev.Organizer.FullName
</div>

</li>
}

</ul>

</div>

</div>

</div>

</div>


<!--USERS TABLE-->

<div class="row">

<div class="col-lg-12">

<div class="card shadow-sm">

<div class="card-header">
<h5 class="mb-0">
Последние зарегистрированные пользователи
</h5>
</div>

<div class="table-responsive">

<table class="table table-hover mb-0">

<thead class="table-light">

<tr>
<th>Имя</th>
<th>Email</th>
<th>Дата регистрации</th>
</tr>

</thead>

<tbody>

@foreach (var user in Model.LatestUsers)
{
<tr>

<td>@user.FullName</td>

<td>@user.Email</td>

<td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>

</tr>
}

</tbody>

</table>

</div>

</div>

</div>

</div>

</div>



@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ctx = document.getElementById("salesChart");

new Chart(ctx, {

type: "line",

data: {

labels: @Html.Raw(Json.Serialize(Model.Last7Days)),

datasets: [

{
label: "Продано билетов",
data: @Html.Raw(Json.Serialize(Model.TicketsLast7Days)),
borderColor: "#0d6efd",
backgroundColor: "rgba(13,110,253,0.1)",
fill: true,
tension: 0.3
}

]

},

options: {

responsive: true,
maintainAspectRatio: false,

plugins:{
legend:{
display:false
}
}

}

});

</script>

}